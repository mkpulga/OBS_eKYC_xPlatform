<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OBS.Maui.Controls.People" xmlns:controls="clr-namespace:OBS.Maui.Controls" 
             x:Name="Root" x:DataType="controls:People">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!!1111"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <VerticalStackLayout
            Spacing="0"
            BindableLayout.ItemsSource="{Binding ItemsSource,
                                         Source={x:Reference Root}}">

            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="controls:PersonRow">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="50,*,110"
                              ColumnSpacing="12"
                              Padding="12"
                              BackgroundColor="Transparent">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Text="{Binding Id}" InputTransparent="True" />

                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   LineBreakMode="TailTruncation"
                                   InputTransparent="True" />

                            <Label Grid.Column="2"
                                   Text="{Binding BirthDate,
                                          StringFormat='{0:yyyy-MM-dd}'}"
                                   InputTransparent="True" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="#DDE3E8" />
                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>

        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>
